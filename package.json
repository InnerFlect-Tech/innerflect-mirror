{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "tsc --noEmit && oxlint && npm run check:tokens && npm run check:glyphs && npm run check:records && npm run check:picks && npm run check:composition && npm run check:pickable-records && npm run check:ecosystem-registry",
    "sync": "git pull --rebase --autostash && npm run check",
    "check:tokens": "esbuild scripts/check-tokens.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-tokens.mjs --log-level=error && node node_modules/.cache/check-tokens.mjs",
    "emit:glyphs": "esbuild scripts/emit-glyph-manifest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/emit-glyphs.mjs --log-level=error && node node_modules/.cache/emit-glyphs.mjs",
    "check:glyphs": "npm run emit:glyphs && git diff --exit-code components/company-world/generated/",
    "check:composition": "esbuild scripts/check-composition.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-composition.mjs --log-level=error --alias:@=. && node node_modules/.cache/check-composition.mjs",
    "check:pickable-records": "esbuild scripts/check-pickable-records.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-pickable-records.mjs --log-level=error --alias:@=. && node node_modules/.cache/check-pickable-records.mjs",
    "check:ecosystem-registry": "esbuild scripts/check-ecosystem-registry.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-ecosystem-registry.mjs --log-level=error --alias:@=. && node node_modules/.cache/check-ecosystem-registry.mjs",
    "check:records": "esbuild scripts/check-no-fabrication.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-records.mjs --log-level=error --alias:@=. && node node_modules/.cache/check-records.mjs",
    "export:world": "esbuild scripts/export-world.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/export-world.mjs --log-level=error --alias:@=. --external:three && node node_modules/.cache/export-world.mjs",
    "capture:ui": "python3 scripts/capture-ui.py",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep 'bounded at supported breakpoints'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "export:kit": "esbuild scripts/export-kit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/export-kit.mjs --log-level=error --alias:@=. --external:three && node node_modules/.cache/export-kit.mjs",
    "check:picks": "esbuild scripts/check-picks.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-picks.mjs --log-level=error --alias:@=. && node node_modules/.cache/check-picks.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@xyflow/react": "^12.11.6",
    "cmdk": "^1.1.1",
    "lucide-react": "1.31.0",
    "maath": "^0.10.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.3.0",
    "three": "0.186.0",
    "vinext": "^1.0.0-beta.9",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "chromatic": "^18.8.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "type": "module"
}

{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "tsc --noEmit && oxlint && npm run check:tokens && npm run check:glyphs && npm run check:records && npm run check:picks",
    "sync": "git pull --rebase --autostash && npm run check",
    "check:tokens": "esbuild scripts/check-tokens.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-tokens.mjs --log-level=error && node node_modules/.cache/check-tokens.mjs",
    "emit:glyphs": "esbuild scripts/emit-glyph-manifest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/emit-glyphs.mjs --log-level=error && node node_modules/.cache/emit-glyphs.mjs",
    "check:glyphs": "npm run emit:glyphs && git diff --exit-code components/company-world/generated/",
    "check:records": "esbuild scripts/check-no-fabrication.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-records.mjs --log-level=error --alias:@=. && node node_modules/.cache/check-records.mjs",
    "export:world": "esbuild scripts/export-world.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/export-world.mjs --log-level=error --alias:@=. --external:three && node node_modules/.cache/export-world.mjs",
    "capture:ui": "python3 scripts/capture-ui.py",
    "export:kit": "esbuild scripts/export-kit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/export-kit.mjs --log-level=error --alias:@=. --external:three && node node_modules/.cache/export-kit.mjs",
    "check:picks": "esbuild scripts/check-picks.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-picks.mjs --log-level=error --alias:@=. && node node_modules/.cache/check-picks.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "lucide-react": "1.31.0",
    "maath": "^0.10.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "three": "0.186.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
